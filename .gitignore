gitignore
# =================================================================
# Fichiers générés par les outils Dart et Flutter
# =================================================================
# Fichiers de métadonnées et de cache de Dart/Pub
.dart_tool/
.packages
.pub-cache/
.pub/

# Le pubspec.lock doit être versionné pour les applications afin de garantir
# des builds reproductibles. Pour les paquets (packages), il est souvent ignoré.
# Pour une application, assurez-vous que la ligne suivante est commentée :
# pubspec.lock

# Répertoire de build de Flutter
build/

# Fichiers de couverture de test
coverage/

# Fichier généré pour l'enregistrement des plugins natifs
lib/generated_plugin_registrant.dart

# FVM
.fvm/


# =================================================================
# Fichiers spécifiques à Android (Android Studio)
# =================================================================
# Fichiers de build Gradle
**/android/.gradle
**/android/app/build/
**/android/build/

# Fichiers de configuration locaux à ne jamais versionner
**/android/key.properties
**/android/local.properties

# Fichiers wrapper de Gradle (généralement versionnés, sauf le .jar)
**/android/gradlew
**/android/gradlew.bat
**/android/gradle/wrapper/gradle-wrapper.jar

# Captures d'écran de test
**/android/captures/

# Fichier d'enregistrement de plugin généré pour Java/Kotlin
**/android/**/GeneratedPluginRegistrant.java


# =================================================================
# Fichiers spécifiques à iOS (Xcode)
# =================================================================
# Fichiers de build et de projet Xcode
**/ios/build/
**/ios/DerivedData/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Runner/GeneratedPluginRegistrant.*

# Fichiers de configuration utilisateur Xcode
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/xcuserdata/

# Frameworks et produits générés par Flutter
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_assets/
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip

# Fichiers divers
**/ios/Flutter/.last_build_id
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/.generated/
**/ios/Runner.xcworkspace

# =================================================================
# Fichiers de configuration des Éditeurs
# =================================================================
# Android Studio / IntelliJ
.idea/
*.iml

# =================================================================
# Fichiers système
# =================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# =================================================================
# Journaux (Logs)
# =================================================================
*.log
logs/

