# .gitignore pour projet Flutter / Android / iOS
# Adapté pour un projet d'application (ne pas ignorer `pubspec.lock` pour app)

# Flutter / Dart
.dart_tool/
.package_config.json
.packages
.flutter-plugins
.flutter-plugins-dependencies
.flutter-credentials
/flutter_*.png
/generated_plugin_registrant.dart
.metadata

# FVM Version Cache
.fvm/


# iOS
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/ServiceDefinitions.json
ios/Flutter/Generated.xcconfig
ios/Flutter/.last_build_id
ios/Pods/
ios/.symlinks/
ios/Runner.xcworkspace/
DerivedData/
*.pbxuser
!default.mode1v3
!default.pbxuser
*.mode1v3
*.mode2v3

# Xcode
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint

# Android
local.properties
**/*.iml
.gradle/
/.gradle/
/android/.cxx/
/captures/
outputs/
.externalNativeBuild/

# Keystores (ne pas commiter vos keystores privés)
**/*.jks
**/*.keystore
android/key.properties

# IntelliJ / Android Studio
.idea/
*.iml

# End of .gitignore
